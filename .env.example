# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_beta?schema=public"

# =============================================================================
#  LLM stack
# =============================================================================
# The matcher and capability-statement generator both go through a provider
# abstraction. Pick a chat backend and an embedding backend independently.
#
# Local-first dev (FREE, runs on your laptop):
#   1. brew install ollama && ollama serve
#   2. ollama pull qwen2.5:7b-instruct       # ~4.5 GB — chat
#      ollama pull qwen2.5:3b-instruct       # ~2.0 GB — fast tier
#      ollama pull mxbai-embed-large         # ~660 MB — 1024-dim embeddings
#   3. leave the defaults below, run `pnpm llm:doctor` to verify.
#
# LM Studio works too: set LLM_PROVIDER=lmstudio, EMBEDDING_PROVIDER=lmstudio,
# and load the same models in LM Studio's UI. It exposes an OpenAI-compatible
# API on http://localhost:1234/v1.
#
# Production: flip LLM_PROVIDER=anthropic (or openai) and EMBEDDING_PROVIDER=
# voyage (or openai). No code changes.
# =============================================================================

# --- Chat provider ---
# ollama | lmstudio | openai | anthropic
LLM_PROVIDER="ollama"
LLM_REASONING_MODEL="qwen2.5:7b-instruct"
LLM_FAST_MODEL="qwen2.5:3b-instruct"
LLM_TIMEOUT_MS="120000"

# --- Embedding provider ---
# ollama | lmstudio | openai | voyage
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="mxbai-embed-large"
# Output dim. Must match the pgvector column dim. mxbai-embed-large=1024,
# nomic-embed-text=768, bge-large=1024, openai text-embedding-3-small=1536
# (configurable). Change only after running `pnpm db:vector-sql` then
# re-applying packages/db/src/migrations/001_pgvector.sql.
EMBEDDING_DIM="1024"
EMBEDDING_TIMEOUT_MS="60000"

# --- Backend endpoints ---
OLLAMA_BASE_URL="http://localhost:11434"
LMSTUDIO_BASE_URL="http://localhost:1234/v1"
LMSTUDIO_API_KEY="lm-studio"

# Cloud (only required if you flip the provider env to one of these)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com"
VOYAGE_API_KEY=""
VOYAGE_BASE_URL="https://api.voyageai.com/v1"

# Set to "false" if your OpenAI-compatible server rejects strict json_schema.
# OAI_STRICT_SCHEMA="true"

# --- Source API keys ---
SAM_GOV_API_KEY=""
TED_EU_API_KEY=""

# --- Email (optional in dev — falls back to console printer) ---
RESEND_API_KEY=""
DIGEST_FROM_EMAIL="alerts@example.com"

# --- App ---
APP_URL="http://localhost:3000"
SESSION_SECRET="change-me-in-production"
NODE_ENV="development"
