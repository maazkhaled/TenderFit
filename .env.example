# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_beta?schema=public"

# =============================================================================
#  LLM stack
# =============================================================================
# The matcher and capability-statement generator both go through a provider
# abstraction. Pick a chat backend and an embedding backend independently.
#
# Local-first dev (FREE, runs on your laptop):
#   1. brew install ollama && ollama serve
#   2. ollama pull qwen2.5:7b-instruct       # ~4.5 GB — chat
#      ollama pull qwen2.5:3b-instruct       # ~2.0 GB — fast tier
#      ollama pull mxbai-embed-large         # ~660 MB — 1024-dim embeddings
#   3. leave the defaults below, run `pnpm llm:doctor` to verify.
#
# LM Studio works too: set LLM_PROVIDER=lmstudio, EMBEDDING_PROVIDER=lmstudio,
# and load the same models in LM Studio's UI. It exposes an OpenAI-compatible
# API on http://localhost:1234/v1.
#
# Production: flip LLM_PROVIDER=anthropic (or openai) and EMBEDDING_PROVIDER=
# voyage (or openai). No code changes.
# =============================================================================

# --- Chat provider ---
# ollama | lmstudio | openai | anthropic | gemini | nvidia
LLM_PROVIDER="ollama"
LLM_REASONING_MODEL="qwen2.5:7b-instruct"
LLM_FAST_MODEL="qwen2.5:3b-instruct"
LLM_TIMEOUT_MS="120000"

# --- Embedding provider ---
# ollama | lmstudio | openai | voyage | gemini | nvidia
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="mxbai-embed-large"
# Output dim. Must match the pgvector column dim. mxbai-embed-large=1024,
# nomic-embed-text=768, bge-large=1024, openai text-embedding-3-small=1536
# (configurable). Change only after running `pnpm db:vector-sql` then
# re-applying packages/db/src/migrations/001_pgvector.sql.
EMBEDDING_DIM="1024"
EMBEDDING_TIMEOUT_MS="60000"

# --- Backend endpoints ---
OLLAMA_BASE_URL="http://localhost:11434"
LMSTUDIO_BASE_URL="http://localhost:1234/v1"
LMSTUDIO_API_KEY="lm-studio"

# Cloud (only required if you flip the provider env to one of these)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com"
VOYAGE_API_KEY=""
VOYAGE_BASE_URL="https://api.voyageai.com/v1"

# --- Google Gemini (FREE TIER — recommended cloud option) ---
# Get a key at https://aistudio.google.com/apikey. The free tier covers
# gemini-2.5-flash at ~10 RPM / 250 RPD as of mid-2026 — plenty for ingest.
# Flip LLM_PROVIDER=gemini (and optionally EMBEDDING_PROVIDER=gemini) and set
# GEMINI_API_KEY. The default chat model is gemini-2.5-flash; embeddings use
# gemini-embedding-001 truncated to EMBEDDING_DIM via the `dimensions` field
# (so you can keep your existing 1024-dim pgvector column).
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"

# --- NVIDIA NIM (FREE TIER for development) ---
# Get a key at https://build.nvidia.com/explore/discover → any model → "Get API Key".
# The hosted gateway exposes an OpenAI-compatible API. Defaults:
#   chat:      meta/llama-3.3-70b-instruct  (reasoning) / meta/llama-3.1-8b-instruct (fast)
#   embedding: baai/bge-m3                  (1024-dim — matches the default column)
# Flip LLM_PROVIDER=nvidia and/or EMBEDDING_PROVIDER=nvidia and set NVIDIA_API_KEY.
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Set to "false" if your OpenAI-compatible server rejects strict json_schema.
# Note: NVIDIA NIM currently does not honor strict mode — leave this default
# OR set OAI_STRICT_SCHEMA=false if you see "strict not supported" errors.
# OAI_STRICT_SCHEMA="true"

# --- Source API keys ---
SAM_GOV_API_KEY=""
TED_EU_API_KEY=""

# --- Email (optional in dev — falls back to console printer) ---
RESEND_API_KEY=""
DIGEST_FROM_EMAIL="alerts@example.com"

# --- App ---
APP_URL="http://localhost:3000"
SESSION_SECRET="change-me-in-production"
NODE_ENV="development"

# Minimum fit score shown on the /dashboard page. Default 30 because local
# LLMs (qwen2.5:7b etc.) score conservatively. Raise to 60+ when running
# against frontier cloud models.
DASHBOARD_MIN_FIT_SCORE="30"
