// Project Beta — DB contract. Owned by Lead. Backend agent extends only with sign-off.
//
// pgvector required: `CREATE EXTENSION IF NOT EXISTS vector;`
// Embedding dim = 1024 to match voyage-3-large.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Explicit binary target prevents Prisma from trying to fetch/verify the
  // engine binary from binaries.prisma.sh during `docker compose build`.
  // Without this, `prisma generate` does a live SHA256 check against the CDN
  // which times out inside the Docker build network on macOS (ARM64 Alpine).
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ---------- Tenancy ----------

model Tenant {
  id          String   @id @default(cuid())
  slug        String   @unique
  companyName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users    User[]
  profile  CapabilityProfile?
  matches  MatchResult[]
  schedule DigestSchedule?
  feedback MatchFeedback[]
}

// One row per (email, tenant) pair — lets one stub-auth email own multiple
// tenants and switch between them. The session's `userEmail` is stable;
// `activeTenantId` is what the rest of the app sees as the current tenant.
model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  name      String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([email, tenantId])
  @@index([email])
  @@index([tenantId])
}

// ---------- Capability profile ----------

model CapabilityProfile {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  oneLiner        String
  industries      String[] @default([])
  techStack       String[] @default([])
  services        String[] @default([])
  certifications  String[] @default([])
  pastClients     String[] @default([])
  pastProjects    Json     @default("[]")
  geographies     String[] @default([])
  teamSize        Int      @default(0)
  budgetMinUsd    Int      @default(0)
  budgetMaxUsd    Int      @default(0)
  languages       String[] @default([])
  // When true, geography is excluded from scoring/retrieval. See
  // CapabilityProfile.ignoreLocation in packages/shared/src/types.ts.
  // Flipping this flag invalidates the profile embedding hash because the
  // flattened-for-embedding text changes; the worker will re-embed on next tick.
  ignoreLocation  Boolean  @default(false)
  embeddingStatus EmbeddingStatus @default(pending)
  // sha256 of (provider:model + flatten-text). When unchanged, embed is skipped.
  embeddingHash   String?
  // provider:model that produced the current embedding. Used to invalidate when env changes.
  embeddingModel  String?
  // The actual vector column is `vector(1024)` (pgvector), added by raw SQL
  // migration packages/db/src/migrations/001_pgvector.sql. Declaring it as
  // Unsupported here tells Prisma the column exists so `db push` does not try
  // to drop it. The Prisma client cannot query Unsupported columns directly —
  // that's fine, all vector operations go through $queryRaw in @beta/db.
  embedding       Unsupported("vector(1024)")?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum EmbeddingStatus {
  pending
  ready
  failed
}

// ---------- Tenders (shared across tenants) ----------

enum TenderSource {
  sam_gov
  ted_eu
  ungm
  world_bank
  ppra_pk
  eprocure_pk
  ppra_punjab
  kppra
  ppra_sindh
  bppra_balochistan
  pda_pk
  nitb_pk
  pseb_pk
  nadra_pk
  planning_commission_pk
  urban_unit_pk
  sop_pk
  ppwd_pk
  pitb_pk
  ignite_pk
  adb
  undp
  etimad_sa
  kuwait_capt
  kuwait_egov_ctc
  kuwait_cbk
  uk_find_a_tender
  uk_contracts_finder
}

model Tender {
  id           String       @id @default(cuid())
  source       TenderSource
  externalId   String
  title        String
  description  String
  url          String
  buyer        String
  country      String?
  sector       String?
  cpvCodes     String[]     @default([])
  budgetMinUsd Int?
  budgetMaxUsd Int?
  currency     String?
  publishedAt  DateTime
  deadlineAt   DateTime?
  language     String       @default("en")
  raw          Json
  // pgvector + tsvector columns are added by raw SQL migrations
  // (001_pgvector.sql and 005_tender_fts.sql). Declared as Unsupported so
  // Prisma's `db push` does not see them as drift and try to drop them.
  // All reads/writes happen via $queryRaw inside @beta/db.
  embedding    Unsupported("vector(1024)")?
  fts_doc      Unsupported("tsvector")?
  embeddingStatus EmbeddingStatus @default(pending)
  embeddingHash   String?
  embeddingModel  String?
  ingestedAt   DateTime     @default(now())

  matches MatchResult[]

  @@unique([source, externalId])
  @@index([publishedAt])
  @@index([deadlineAt])
}

// ---------- Match results ----------

enum WinProbability {
  low
  medium
  high
}

model MatchResult {
  id                   String         @id @default(cuid())
  tenantId             String
  tenderId             String
  fitScore             Int            // 0..100
  rationale            String[]       // exactly 3 bullets
  gaps                 Json           @default("[]")
  winProbability       WinProbability
  winProbabilityReason String
  humanResourcesEstimate Json         @default("{}")
  capabilityStatement  String?        // generated on-demand
  modelVersion         String
  createdAt            DateTime       @default(now())

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  feedback MatchFeedback?

  @@unique([tenantId, tenderId])
  @@index([tenantId, fitScore])
}

model MatchFeedback {
  id         String   @id @default(cuid())
  matchId    String   @unique
  tenantId   String
  interested Boolean
  note       String?
  createdAt  DateTime @default(now())

  match  MatchResult @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ---------- Digest schedule ----------

enum DigestFrequency {
  daily
  every_n_days
  weekly
  monthly
}

model DigestSchedule {
  id            String          @id @default(cuid())
  tenantId      String          @unique
  frequency     DigestFrequency @default(weekly)
  /// Number of days between sends when frequency = every_n_days. Ignored for other modes.
  intervalDays  Int             @default(2)
  /// Start of the preferred local delivery window, 0..23.
  /// (Kept as `hourLocal` for back-compat with existing rows; semantically the window opens here.)
  hourLocal     Int             @default(8)
  /// End of the preferred local delivery window, 0..23. Must be >= hourLocal.
  /// The worker may fire any time the local hour is in [hourLocal, hourLocalEnd].
  hourLocalEnd  Int             @default(10)
  dayOfWeek     Int?            // 0=Sun..6=Sat (weekly only)
  dayOfMonth    Int?            // 1..31 (monthly only). 31 = "last day of month" in worker logic.
  timezone      String          @default("UTC")
  enabled       Boolean         @default(true)
  lastSentAt    DateTime?
  minFitScore   Int             @default(60)
  /// Email addresses the digest is delivered to. When empty, falls back to
  /// the env var DIGEST_TEST_RECIPIENT (legacy single-recipient behaviour).
  recipients    String[]        @default([])
  updatedAt     DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
